generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}


model List {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  title       String
  type        Type
  color       String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sharedWith SharedLists[]

  @@index([userId])
}

enum Type {
  shopping
  tasks
  events
}


model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  deviceId  String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([deviceId])
  @@unique([userId, deviceId])
}


model SharedLists {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  owner       User     @relation("SharedListOwner", fields: [ownerId], references: [id])
  recipientId Int
  recipient   User     @relation("SharedListRecipient", fields: [recipientId], references: [id])
  listId      Int
  list        List     @relation(fields: [listId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([ownerId, recipientId, listId])
}


model User {
  id                   Int            @id @default(autoincrement())
  email                String         @unique
  password             String
  name                 String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  avatar               String?
  
  RefreshToken         RefreshToken[]
  List                 List[]

  ownedSharedLists     SharedLists[] @relation("SharedListOwner")
  receivedSharedLists  SharedLists[] @relation("SharedListRecipient")
}
