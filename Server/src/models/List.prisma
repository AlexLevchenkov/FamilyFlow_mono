model List {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  title          String
  type           Type
  color          String?
  icon           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sharedWith     SharedLists[]
  items          Item[]

  @@index([userId])
}

model SharedLists {
  id              Int             @id @default(autoincrement())
  ownerId         Int
  owner           User            @relation("SharedListOwner", fields: [ownerId], references: [id])
  recipientId     Int
  recipient       User            @relation("SharedListRecipient", fields: [recipientId], references: [id])
  listId          Int
  list            List            @relation(fields: [listId], references: [id])
  accessTypes     AccessTypes     @default(watch)
  createdAt       DateTime        @default(now())

  @@unique([ownerId, recipientId, listId])
}

enum Type {
  shopping
  tasks
  events
}

enum AccessTypes {
  watch
  edit
  fullAccess
}
