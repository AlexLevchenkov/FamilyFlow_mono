model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  avatar        String?
  
  RefreshToken  RefreshToken[]
  Event         Event[]
  FamilyMember  FamilyMember[]
  Goal          Goal[]
  Task          Task[]

  resetToken    String?
  resetTokenExp DateTime?
  emailVerified Boolean        @default(false)
}
