model User {
  id                   Int            @id @default(autoincrement())
  email                String         @unique
  password             String
  name                 String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  avatar               String?
  
  RefreshToken         RefreshToken[]
  List                 List[]

  resetToken           String?
  resetTokenExp        DateTime?
  emailVerified        Boolean       @default(false)

  ownedSharedLists     SharedLists[] @relation("SharedListOwner")
  receivedSharedLists  SharedLists[] @relation("SharedListRecipient")
  ownedFamily          Family?       @relation("FamilyOwner")
  familyMembership     FamilyMember?
}
