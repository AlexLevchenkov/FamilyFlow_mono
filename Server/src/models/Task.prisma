model Task {
  id         Int        @id @default(autoincrement())
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  title      String
  type       Type
  visibility Visibility
  status     Boolean    @default(false)
  date       DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

enum Visibility {
  shared
  personal
  secret
}

enum Type {
  home
  family
  work
  health
  finance
  learning
  personal
  social
  travel
  other
}
