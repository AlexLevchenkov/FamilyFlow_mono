generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}


model Event {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  title         String
  color         String
  date          DateTime
  repeatability Repeatability
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
}

enum Repeatability {
  day
  working
  week
  month
  quarter
  year
}


enum FamilyRole {
  OWNER
  PARENT
  CHILD
  MEMBER
}

model Family {
  id           Int            @id @default(autoincrement())
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  FamilyMember FamilyMember[]
  Goal         Goal[]
}

model FamilyMember {
  id        Int        @id @default(autoincrement())
  userId    Int
  familyId  Int
  role      FamilyRole @default(MEMBER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@index([familyId])
}


enum GoalType {
  AMOUNT
  COUNTER
  STEPS
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Goal {
  id           Int        @id @default(autoincrement())
  familyId     Int
  createdById  Int

  title        String     @db.VarChar(150)
  description  String?    @db.Text

  type         GoalType
  status       GoalStatus @default(ACTIVE)

  currentValue Int?       @default(0) 
  targetValue  Int?   

  unit         String?    @db.VarChar(30)
  currency     String?    @db.VarChar(3)

  startsAt     DateTime?
  dueDate      DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  family       Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy    User       @relation(fields: [createdById], references: [id])
  steps        GoalStep[]

  @@index([familyId, status])
  @@index([createdById])
  @@index([dueDate])
}

model GoalStep {
  id          Int       @id @default(autoincrement())
  goalId      Int

  title       String    @db.VarChar(150)
  description String?   @db.Text
  position    Int       @default(0)
  completed   Boolean   @default(false)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, position])
}


model RefreshToken {
  id        Int      @id @default(autoincrement())
  jti       String   @default("")
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}


model Task {
  id         Int        @id @default(autoincrement())
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  title      String
  type       Type
  visibility Visibility
  status     Boolean    @default(false)
  date       DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

enum Visibility {
  shared
  personal
  secret
}

enum Type {
  home
  family
  work
  health
  finance
  learning
  personal
  social
  travel
  other
}


model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  avatar        String?
  
  RefreshToken  RefreshToken[]
  Event         Event[]
  FamilyMember  FamilyMember[]
  Goal          Goal[]
  Task          Task[]

  resetToken    String?
  resetTokenExp DateTime?
  emailVerified Boolean        @default(false)
}
