{
  "name": "@familyflow/common",
  "private": true,
  "version": "0.1.0",
  "type": "module",

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },

  "scripts": {
    "build": "tsc --build",
    "dev": "rm -rf dist tsconfig.tsbuildinfo && tsc --build --watch"
  },

  "peerDependencies": {
    "react": "^18.2.0",
    "@tanstack/react-query": "^5.0.0"
  },

  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/react": "^18.3.0"
  }
}
