{
  "name": "familyflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:common": "cd common && pnpm dev",
    "dev:web": "cd web && pnpm dev",
    "dev:mobile": "cd mobile && pnpm start",
    "build:common": "cd common && pnpm build",
    "build:web": "cd web && pnpm build",
    "build:mobile": "cd mobile && pnpm build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "reset": "rm -rf pnpm-lock.yaml node_modules common/node_modules mobile/node_modules web/node_modules && pnpm install"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "eslint": "^8.57.0"
  }
}
