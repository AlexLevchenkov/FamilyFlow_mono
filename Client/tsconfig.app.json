{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "baseUrl": ".",
    "paths": {
      "@api": ["src/shared/api/index.ts"],
      "@api/*": ["src/shared/api/*"],
      "@assets/*": ["src/shared/assets/*"],
      "@features/*": ["src/features/*"],
      "@hooks/*": ["src/features/auth/hooks/*"],
      "@layouts/*": ["src/shared/layouts/*"],
      "@lib/*": ["src/shared/lib/*"],
      "@types": ["src/shared/types/index.ts"],
      "@types/*": ["src/shared/types/*"],
      "@mocks": ["src/shared/mocks/index.ts"],
      "@mocks/*": ["src/shared/mocks/*"],
      "@pages": ["src/pages/index.ts"],
      "@pages/*": ["src/pages/*"],
      "@schemas": ["src/features/auth/schemas/index.ts"],
      "@schemas/*": ["src/features/auth/schemas/*"],
      "@store/*": ["src/features/auth/store/*"],
      "@store": ["src/features/auth/store/index.ts"],
      "@styles/*": ["src/shared/styles/*"],
      "@ui": ["src/shared/ui/index.ts"],
      "@ui/*": ["src/shared/ui/*"],
      "@atoms/*": ["src/shared/ui/atoms/*"],
      "@molecules/*": ["src/shared/ui/molecules/*"],
      "@organisms/*": ["src/shared/ui/organisms/*"],
      "@templates/*": ["src/shared/ui/templates/*"]
    }
  },
  "include": ["src", "vitest.setup.ts"]
}
